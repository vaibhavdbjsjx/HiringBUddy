# HiringBuddy backend configuration.
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- AI provider (all OpenAI-compatible) ---
# Choose one: groq | sambanova | openai. Empty = auto-detect from the key shape.
AI_PROVIDER=groq
# Set the key for your chosen provider. Leave all blank to run the resume/interview
# pipeline in deterministic offline-only mode (no external calls).
GROQ_API_KEY=
# OPENAI_API_KEY=          # used when AI_PROVIDER=openai or sambanova
# Optional overrides (else provider-appropriate defaults are used):
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile

# --- Database ---
# Local dev defaults to SQLite. Use a Postgres URL in production.
DATABASE_URL=sqlite:///./hiringbuddy.db

# --- Outbound email (SMTP) ---
# Optional here; can also be configured at runtime in the Settings UI.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- CORS / frontend origin ---
FRONTEND_URL=http://localhost:5173

# --- Auth / JWT ---
# Generate a strong secret (32+ bytes):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Access-token lifetime in minutes (default = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080
